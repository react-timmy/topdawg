# FilmSort — environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.

# ── Proxy URL (the ONLY value the app needs) ──────────────────────────────────
# After deploying the Cloudflare Worker, paste the URL here.
# Format: https://filmsort-proxy.<your-subdomain>.workers.dev
# You get this URL from the `wrangler deploy` command output.
EXPO_PUBLIC_PROXY_BASE_URL=https://filmsort-proxy.YOUR_SUBDOMAIN.workers.dev

# ── Keys now live in Cloudflare Worker Secrets (server-side only) ─────────────
# DO NOT put TMDB_API_KEY or GEMINI_API_KEY here anymore.
# Set them once with the Wrangler CLI:
#
#   cd worker
#   npx wrangler secret put TMDB_API_KEY
#   npx wrangler secret put GEMINI_API_KEY
#   npx wrangler secret put GEMINI_PRO_API_KEY   (optional, for Pro lane)

# ── Google Sign-In / Firebase ─────────────────────────────────────────────────
# Web Client ID from Firebase Console → Authentication → Sign-in method →
# Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase project ID (found in Firebase Console → Project settings)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=filmoor-49db3

# Set to "false" to disable cloud sync entirely (app runs as pure local v1.1)
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=true

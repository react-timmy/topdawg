# FilmSort — environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.

# ── Existing keys ─────────────────────────────────────────────────────────────
# These are also mirrored in app.json → extra for Expo Constants compatibility.
# After changing, rebuild the app (EAS build or expo start).
TMDB_API_KEY=
GEMINI_API_KEY=

# ── Google Sign-In / Firebase (Task 1 — v1.2) ─────────────────────────────────
# Web Client ID from Firebase Console → Authentication → Sign-in method →
# Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase project ID (found in Firebase Console → Project settings)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Set to "false" to disable cloud sync entirely (app runs as pure local v1.1)
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=true
